<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../SimpleExpenseTracker.Infrastructure/SimpleExpenseTracker.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.25"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <Target Name="IncludeFrontendForPublish" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('../../frontend/simple-expense-tracker-web/dist/sw.js')" Text="Build the frontend with pnpm build before publishing." />
    <ItemGroup>
      <FrontendFiles Include="../../frontend/simple-expense-tracker-web/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(FrontendFiles.RecursiveDir)%(FrontendFiles.Filename)%(FrontendFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
